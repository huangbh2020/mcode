# Dependencies
node_modules/

# Build outputs
dist/
dist-electron/
out/
*.tsbuildinfo

# Electron
release/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Env
.env
.env.local
